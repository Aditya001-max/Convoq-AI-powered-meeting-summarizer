# Convoq Environment Configuration
# Copy this file to .env and fill in your values

# ── Primary AI (Anthropic Claude) ────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Audio Transcription (Groq Whisper API — free tier: 7,200s/day) ────────────
# Get your free key at: https://console.groq.com/
GROQ_API_KEY=gsk_your-groq-key-here

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-in-production
FLASK_ENV=development

# ── Database (defaults to SQLite for local dev) ────────────────────────────────
# For production (Vercel + Neon): use the pooler connection string
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Google Calendar Integration — optional ────────────────────────────────────
# 1. Create a project at https://console.cloud.google.com
# 2. Enable the Google Calendar API
# 3. Create OAuth 2.0 credentials (Web Application)
# 4. Add https://your-domain.vercel.app/calendar/callback as authorised redirect URI
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
